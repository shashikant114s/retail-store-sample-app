{
                         "Version": "2012-10-17",
                         "Statement": [
                                                  {
                                                                           "Effect": "Allow",
                                                                           "Action": [
                                                                                                    "ecr:BatchCheckLayerAvailability",
                                                                                                    "ecr:BatchGetImage",
                                                                                                    "ecr:CompleteLayerUpload",
                                                                                                    "ecr:GetDownloadUrlForLayer",
                                                                                                    "ecr:InitiateLayerUpload",
                                                                                                    "ecr:PutImage",
                                                                                                    "ecr:UploadLayerPart"
                                                                           ],
                                                                           "Resource": "arn:aws:ecr:<region>:<account-id>:repository/*"
                                                  },
                                                  {
                                                                           "Effect": "Allow",
                                                                           "Action": "ecr:GetAuthorizationToken",
                                                                           "Resource": "*"
                                                  }
                         ]
}